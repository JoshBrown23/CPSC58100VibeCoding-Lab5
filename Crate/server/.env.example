# Port the Express server listens on
PORT=4000

# PostgreSQL connection string. This matches docker-compose.yml's default
# credentials — if you're using your own Postgres instance instead, swap
# in its user/password/host/port/database name.
DATABASE_URL="postgresql://crate:crate@localhost:5432/crate"

# MusicBrainz requires a descriptive User-Agent identifying your app and
# a contact method (an email or a URL). Requests without one are liable
# to be rate-limited more aggressively or blocked outright.
# See: https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting
MUSICBRAINZ_USER_AGENT=Crate/0.1.0 ( your-email@example.com )
